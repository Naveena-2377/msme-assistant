# Copy this file to .env (same folder) and fill in your real key.
# .env is gitignored — never commit real API keys.

# Required only for LLM-assisted drafting (collections reminders, vendor
# emails, WhatsApp order parsing). Uses the Gemini API for its free tier.
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
