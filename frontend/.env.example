# Copy this file to .env (same folder) for local overrides, or set
# VITE_API_BASE as an environment variable in your hosting platform
# (Vercel, Netlify) when deploying.
#
# Local dev: leave this unset — it defaults to http://127.0.0.1:8000
# Production: set it to your deployed backend's URL, e.g.
#   VITE_API_BASE=https://your-backend.up.railway.app

VITE_API_BASE=
